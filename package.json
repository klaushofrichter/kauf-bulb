{
  "name": "kauf-bulb",
  "version": "1.0.5",
  "description": "Local server for discovering and controlling Kauf Bulbs via ESPHome API",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "stop": "lsof -ti :${PORT:-3001} | xargs -r kill -9 2>/dev/null || echo 'No process found on port'",
    "test": "vitest run && playwright test",
    "test:watch": "vitest",
    "test:api": "vitest run --config vitest.config.js tests/api/api.test.js",
    "test:api:integration": "vitest run --config vitest.config.js tests/api/integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "husky": "^9.1.7",
    "supertest": "^7.0.0",
    "vite": "^7.2.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
